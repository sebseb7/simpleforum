PORT=3001
DATABASE_PATH=./server/data/romanum.sqlite
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=you@gmail.com
CLIENT_ORIGIN=http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
# Log level: debug | info | warn | error (default info)
# LOG_LEVEL=info
# Force ANSI colors even when stdout is not a TTY (pm2). Set 0 to disable.
# LOG_COLOR=3
# SSE heartbeat interval in ms (default 10000). Keep well under Chrome HTTP/2 PING budget.
# SSE_HEARTBEAT_MS=10000
# Log named SQL slower than this many ms (default 2)
# SLOW_SQL_MS=2
# Optional: enable POST /api/auth/test-login for Playwright (never set in production)
# E2E_AUTH_SECRET=e2e-secret
