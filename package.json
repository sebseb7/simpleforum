{
  "name": "romanum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "server": "node --watch server/src/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "node --test server/src/content/*.test.js shared/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:update-snapshots": "playwright test e2e/00-visual.spec.js --update-snapshots",
    "admin": "node server/scripts/toggle-admin.js",
    "seed:stress": "node server/scripts/seed-stress.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.12.0",
    "better-sqlite3": "^13.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "html-react-parser": "^6.1.5",
    "i18next": "^26.3.6",
    "jsonwebtoken": "^9.0.3",
    "quill-resize-image": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-quill-new": "^3.8.3",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "redux": "^5.0.1",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "vite": "^8.1.5"
  }
}
